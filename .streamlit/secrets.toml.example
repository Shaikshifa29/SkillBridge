# SkillBridge Configuration Template
# Copy this file to .streamlit/secrets.toml and fill in your credentials.

# -----------------------------------------------------------------------------
# 1. SUPABASE AUTHENTICATION & DATABASE (Required for Cloud Multi-User Auth)
# -----------------------------------------------------------------------------
# 1. Sign in to https://app.supabase.com
# 2. Select your project -> Project Settings -> API
# 3. Copy "Project URL" and "anon" public key below
# 4. Run supabase_schema.sql in your Supabase SQL Editor to set up tables and RLS policies.

SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key-here"

# -----------------------------------------------------------------------------
# 2. ARIS CLOUD AI ASSISTANT (Optional - For Live Gemini or OpenAI Cloud Models)
# -----------------------------------------------------------------------------
# ARIS automatically connects to Google Gemini or OpenAI when an API key is provided.
# If omitted, ARIS operates using its built-in local technical intelligence engine.

# Google Gemini API key (Get one from https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY = "AIzaSy..."

# OpenAI API key (Optional alternative: https://platform.openai.com/api-keys)
# OPENAI_API_KEY = "sk-..."

# Groq API key (Optional alternative: https://console.groq.com)
# GROQ_API_KEY = "gsk_..."
