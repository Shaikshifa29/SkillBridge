# SkillBridge Supabase Secrets Configuration Template
# Copy this file to .streamlit/secrets.toml and fill in your Supabase project credentials.
#
# How to get your Supabase credentials:
# 1. Sign in to https://app.supabase.com
# 2. Select your project (or create a new project)
# 3. Go to Project Settings -> API
# 4. Copy "Project URL" and paste it into SUPABASE_URL below
# 5. Copy "Project API Keys" -> "anon" "public" key and paste into SUPABASE_ANON_KEY below
# 6. Run supabase_schema.sql in your Supabase SQL Editor to set up tables and RLS policies.

SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_ANON_KEY = "your-anon-public-key-here"

